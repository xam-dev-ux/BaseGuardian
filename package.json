{
  "name": "baseguardian",
  "version": "1.0.0",
  "description": "Autonomous AI security agent monitoring Base Mainnet for scam contracts",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/src/index.js",
    "deploy:contracts": "tsx contracts/deploy.ts",
    "test": "tsx tests/test_full_workflow.ts",
    "test:unit": "vitest run tests/lib",
    "test:integration": "tsx tests/test_full_workflow.ts",
    "test:websocket": "tsx test_websocket.ts",
    "stats": "tsx scripts/stats.ts",
    "db:check": "tsx check_db.ts",
    "twitter:test": "tsx test_twitter.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "base",
    "blockchain",
    "security",
    "ai-agent",
    "openclaw",
    "defi"
  ],
  "author": "BaseGuardian Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "bullmq": "^5.28.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "ioredis": "^5.4.2",
    "twitter-api-v2": "^1.18.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "hardhat": "^2.22.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
